
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProcessedObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::ecommerce-pipeline-4488",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "processed/",
            "processed/*"
          ]
        }
      }
    },
    {
      "Sid": "GetBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::ecommerce-pipeline-4488"
    },
    {
      "Sid": "ReadProcessedObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::ecommerce-pipeline-4488/processed/*"
    }
  ]
}
